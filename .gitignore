# Confidential / local data
data/raw/*
data/processed/*
data/reference/*

# Preserve directory documentation/placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reference/README.md

# Generated outputs
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Credentials and environment files
.env
.env.*
*.pem
*.key
*.pfx
credentials.*
secrets.*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
